{
  "name": "datavirgo-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "echo 'pnpm dev becomes the Astro dev server in DAV-11'",
    "build": "echo 'pnpm build becomes the Astro production build in DAV-11'",
    "check": "echo 'pnpm check becomes astro check in DAV-11'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,md,mdc,json,yml,yaml}": "prettier --write",
    "*.{js,mjs,cjs}": "eslint --fix"
  }
}
