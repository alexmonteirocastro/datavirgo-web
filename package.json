{
  "name": "datavirgo-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:literals": "node scripts/test-no-raw-text.mjs",
    "test:pt-build": "node scripts/check-pt-build.mjs",
    "test:testimonials": "node scripts/check-testimonials.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.72.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,md,mdc,json,yml,yaml}": "prettier --write",
    "*.{js,mjs,cjs}": "eslint --fix"
  },
  "dependencies": {
    "astro": "^7.4.5"
  }
}
