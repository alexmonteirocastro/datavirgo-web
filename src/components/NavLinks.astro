---
import { visibleNavItems } from "../config/nav";
import { t } from "../i18n";
import type { RouteKey } from "../i18n/routes";
import { href } from "../lib/href";

interface Props {
  locale: string;
  route?: RouteKey;
  /** inline: a row in the header. stacked: a column in the mobile menu. */
  variant: "inline" | "stacked";
  /** Header-only link to the consultations enquire anchor. Not a route. */
  enquireHref: string;
}

const { locale, route, variant, enquireHref } = Astro.props;
const items = visibleNavItems();
---

<ul class:list={["nav-list", `nav-list--${variant}`]}>
  {items.map((item) => (
    <li>
      <a
        class="nav-link"
        href={
          item.linkTo
            ? href(item.linkTo.route, locale, item.linkTo.hash)
            : href(item.route, locale)
        }
        aria-current={item.route === route ? "page" : undefined}
      >
        {t(item.label, locale)}
      </a>
    </li>
  ))}
  <li>
    <a class="nav-link" href={enquireHref}>
      {t("nav.enquire", locale)}
    </a>
  </li>
</ul>

<style>
  .nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list--inline {
    display: flex;
    gap: var(--space-1) var(--space-6);
  }

  .nav-link {
    display: flex;
    align-items: center;
    min-height: var(--touch-target-min);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-text);
  }

  .nav-link[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }
</style>
