---
// Home-page chart-tool section. Rendered only while features.chartTool is on (see index.astro).
import { defaultLocale, t } from "../i18n";
import { href } from "../lib/href";

const locale = Astro.currentLocale ?? defaultLocale;
---

<section data-feature="chartTool">
  <h2>{t("chart.title", locale)}</h2>
  <p>{t("chart.stub", locale)}</p>
  <a href={href("chart", locale)}>{t("nav.chart", locale)}</a>
</section>
