---
import PlaceholderMark from "./PlaceholderMark.astro";
import { sourceRepoUrl, substackUrl } from "../config/site";
import { t } from "../i18n";
import { href } from "../lib/href";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a class="wordmark" href={href("home", locale)}>
      <span class="wordmark__data">{t("site.wordmarkData", locale)}</span>
      <span class="wordmark__virgo">{t("site.wordmarkVirgo", locale)}</span>
    </a>
    <ul class="footer-links">
      <li>
        <a href={href("about", locale)}>{t("nav.about", locale)}</a>
      </li>
      <li>
        <a href={href("about", locale, "approach")}>
          {t("nav.approach", locale)}
        </a>
      </li>
      <li>
        <a href={href("consultations", locale)}>
          {t("nav.consultations", locale)}
        </a>
      </li>
      <li>
        <a href={href("blog", locale)}>{t("nav.blog", locale)}</a>
      </li>
      <li>
        <a href={substackUrl}>{t("footer.substack", locale)}</a>
      </li>
      <li>
        <a href={href("privacy", locale)}>{t("footer.privacy", locale)}</a>
      </li>
      <li>
        <a href={sourceRepoUrl}>{t("footer.source", locale)}</a>
      </li>
    </ul>
    <PlaceholderMark>
      <p class="footer-email">{t("footer.email", locale)}</p>
    </PlaceholderMark>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    border-top: var(--border-width) solid var(--color-rule);
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
  }

  .wordmark__data {
    color: var(--color-link);
  }

  .wordmark__virgo {
    color: var(--color-text);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target-min);
    color: inherit;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--color-text);
  }

  .footer-email {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-2xs);
  }
</style>
