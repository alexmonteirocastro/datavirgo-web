---
import PlaceholderMark from "./PlaceholderMark.astro";

interface Props {
  quote: string;
  name: string;
  context: string;
  marked: boolean;
}

const { quote, name, context, marked } = Astro.props;
---

<blockquote class="quote">
  {marked ? (
    <PlaceholderMark>
      <p>{quote}</p>
      <footer>
        {name}
        <span aria-hidden="true"> · </span>
        {context}
      </footer>
    </PlaceholderMark>
  ) : (
    <>
      <p>{quote}</p>
      <footer>
        {name}
        <span aria-hidden="true"> · </span>
        {context}
      </footer>
    </>
  )}
</blockquote>

<style>
  .quote {
    margin: 0;
  }

  .quote p {
    margin-block: 0 var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-heading);
  }

  .quote footer {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-2xs);
    letter-spacing: var(--letter-spacing-eyebrow);
  }
</style>
