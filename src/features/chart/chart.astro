---
// The /chart page. It lives outside src/pages/ and is injected by astro.config.mjs
// only while features.chartTool is on.
import Base from "../../layouts/Base.astro";
import { defaultLocale, t } from "../../i18n";

const locale = Astro.currentLocale ?? defaultLocale;
---

<Base title="chart.title" route="chart">
  <h1>{t("chart.title", locale)}</h1>
  <p>{t("chart.stub", locale)}</p>
</Base>
