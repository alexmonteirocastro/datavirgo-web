import ChartSection from "../components/ChartSection.astro";
import { features } from "../config/features";
import { t } from "../i18n";
---

<Base title={t("pages.home.title")} route="home">
  <h1>{t("pages.home.title")}</h1>
  <p>{t("pages.placeholder")}</p>
  {features.chartTool && <ChartSection />}
</Base>
