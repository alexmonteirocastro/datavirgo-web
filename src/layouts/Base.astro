---
import "../styles/tokens.css";
import "../styles/fonts.css";
import "../styles/global.css";
import ThemeScript from "../components/ThemeScript.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { isIndexableHost } from "../config/site";
import { defaultLocale, t, type MessageKey } from "../i18n";
import { routeLocales, type RouteKey } from "../i18n/routes";
import { href } from "../lib/href";

interface Props {
  /** A key in the locale catalogue. A raw string is a type error, so it cannot bypass t(). */
  title: MessageKey;
  /** The page's route key. Pages that are not in the route map (404) leave it out. */
  route?: RouteKey;
}

const { title, route } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const pageTitle = t(title, locale);

function descriptionKey(page: RouteKey | undefined): MessageKey {
  switch (page) {
    case "home":
      return "pages.home.description";
    case "about":
    case "approach":
      return "pages.about.description";
    case "consultations":
      return "pages.consultations.description";
    case "testimonials":
      return "pages.testimonials.description";
    case "blog":
      return "pages.blog.description";
    case "privacy":
      return "pages.privacy.description";
    case "chart":
      return "chart.stub";
    case undefined:
      return "pages.notFound.description";
  }
}

const description = t(descriptionKey(route), locale);

// hreflang and canonical need absolute URLs, so they are emitted only once `site` is set.
// A locale without a slug for this route has no page to point at.
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const indexable = site ? isIndexableHost(site.hostname) : false;
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const alternates =
  site && route
    ? routeLocales(route).map((alt) => ({
        locale: alt,
        url: new URL(href(route, alt), site).href,
      }))
    : [];
const xDefault = alternates.find((alt) => alt.locale === defaultLocale);
const documentTitle =
  route === "home" ? pageTitle : `${pageTitle} · ${t("site.name", locale)}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t("site.name", locale)} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={alt.url} />
    ))}
    {xDefault && (
      <link rel="alternate" hreflang="x-default" href={xDefault.url} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("a11y.skipToContent", locale)}
    </a>
    <Header locale={locale} route={route} />
    <main id="main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer locale={locale} />
    {beaconToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      />
    )}
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-raised);
    color: var(--color-text);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
